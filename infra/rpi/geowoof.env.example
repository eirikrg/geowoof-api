# /etc/geowoof/geowoof.env on the Raspberry Pi (root:geowoof, mode 640). infra/rpi/setup-secrets.sh creates
# it with generated values: do not copy real values here, this file is in git.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080
AllowedHosts=api.eirikrg.com;127.0.0.1;localhost
DOTNET_gcServer=0
DOTNET_GCgen0size=0x1000000
DOTNET_TieredPGO=0

ConnectionStrings__Postgres=Host=/var/run/postgresql;Database=geowoof;Username=geowoof;Maximum Pool Size=20
ConnectionStrings__Redis=127.0.0.1:6379
Database__ApplyMigrationsOnStartup=true

Auth__Jwt__SigningKey=generated-at-least-32-characters
Auth__Google__ClientIds__0=web-client-id-of-google-oauth

Storage__ServiceUrl=http://127.0.0.1:8333
Storage__PublicEndpoint=https://s3.eirikrg.com
Storage__AccessKey=generated
Storage__SecretKey=generated
Storage__Bucket=geowoof-media
Storage__CreateBucketIfMissing=true

# The app sends 2048 px at most (ImageCompressor); decoding 64 MP, the general limit, would take about 245 MiB.
Media__MaxImagePixels=5000000

Firebase__CredentialsPath=/etc/geowoof/firebase-adminsdk.json

Email__FromAddress=no-reply@eirikrg.com
Email__FromName=GeoWoof
Email__SmtpHost=smtp.resend.com
Email__SmtpPort=587
Email__SmtpSecurity=StartTls
Email__SmtpUserName=resend
Email__SmtpPassword=api-key-of-resend
