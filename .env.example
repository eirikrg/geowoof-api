# Copy to .env (git-ignored) to override docker compose defaults. Every value below is optional:
# without a .env file, `docker compose up` uses local-only development defaults.

# PostgreSQL credentials of the local database.
# POSTGRES_USER=geowoof
# POSTGRES_PASSWORD=geowoof_dev_only

# Send logs, traces and metrics to the Aspire Dashboard (`docker compose --profile observability up`).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889

# Host that the app uses to reach the images (signed links). Default: the Android emulator.
# On a physical device on the same network: the IP of this computer, as in API_BASE_URL.
# STORAGE_PUBLIC_ENDPOINT=http://192.168.1.50:8333

# HMAC key of the access tokens (at least 32 characters). Local default: a throwaway development key.
# JWT_SIGNING_KEY=

# Google OAuth "Web application" client id, to enable Sign in with Google (docs/setup.md, section 5.2).
# GOOGLE_WEB_CLIENT_ID=

# Real pushes (docs/setup.md, 5.3): the service account key of Firebase, outside the repository, and the
# Compose file that lends it to the API. Without them, the API writes to its log what it would have sent.
# FIREBASE_CREDENTIALS_FILE=C:/ruta/fuera/del/repositorio/firebase-adminsdk.json
# COMPOSE_FILE=docker-compose.yml;docker-compose.firebase.yml
# COMPOSE_PATH_SEPARATOR=;
