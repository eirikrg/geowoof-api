{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "CorsAllowedOrigins": [],
    "GlobalPermitsPerMinute": 600,
    "AuthPermitsPerMinute": 10,
    "RefreshPermitsPerMinute": 30
  },
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "RefreshTokenFamilyLifetime": "180.00:00:00",
    "RefreshTokenReuseGracePeriod": "00:00:30",
    "MaxFailedSignInAttempts": 5,
    "LockoutDuration": "00:05:00",
    "VerificationCodeLifetime": "00:15:00",
    "VerificationCodeMaxAttempts": 5,
    "VerificationCodeResendCooldown": "00:01:00",
    "Jwt": {
      "Issuer": "geowoof",
      "Audience": "geowoof-app"
    },
    "Google": {
      "ClientIds": []
    }
  },
  "Email": {
    "FromAddress": "no-reply@geowoof.local",
    "FromName": "GeoWoof",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls"
  },
  "Storage": {
    "Bucket": "geowoof-media",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Outbox": {
    "BatchSize": 50,
    "PollingInterval": "00:00:02",
    "MaxAttempts": 10,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00"
  }
}
