{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "CorsAllowedOrigins": [],
    "GlobalPermitsPerMinute": 600
  },
  "Storage": {
    "Bucket": "geowoof-media",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Outbox": {
    "BatchSize": 50,
    "PollingInterval": "00:00:02",
    "MaxAttempts": 10,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00"
  }
}
