{
  "//": "Copy to appsettings.Development.json (git-ignored) to run the API with `dotnet run` against the docker compose services. See docs/setup.md.",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=geowoof;Username=geowoof;Password=geowoof_dev_only",
    "Redis": "localhost:6379"
  },
  "Storage": {
    "ServiceUrl": "http://localhost:8333",
    "AccessKey": "geowoof",
    "SecretKey": "geowoof_dev_only_secret",
    "Bucket": "geowoof-media",
    "CreateBucketIfMissing": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDevelopmentData": true
  },
  "Api": {
    "ExposeDocumentation": true
  }
}
